{
  "manifest_version": 3,
  "name": "Pitch Previs Frame",
  "version": "0.2.0",
  "description": "Legt mit einem Klick ein Standbild (First/Mid/Last) direkt hinter ein ausgewähltes Video in Pitch.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.pitch.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*"
      ],
      "matches": [
        "https://app.pitch.com/*"
      ]
    }
  ],
  "permissions": [
    "storage"
  ]
}
